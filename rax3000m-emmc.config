#
# ImmortalWrt 24.10.6 - CMCC RAX3000M (eMMC / 算力版)
# Kernel 6.6 LTS | aarch64_cortex-a53 | mediatek/filogic
#
# 设计原则：稳定优先。
#  - 所有 OpenClash 需要的 kmod 一律「编译进固件」，避免日后 kmod 与内核版本不符。
#  - 不选任何 docker / containerd / dockerd。
#  - 无线使用开源 mt76，不拉满功放。
#

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000m=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_PROFILE="DEVICE_cmcc_rax3000m"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y

# ---------- 系统基础 ----------
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_terminfo=y

# base-files 里的默认设置由 diy-part2.sh 注入（主机名/签名/WiFi/UPnP/终端）

# ---------- 网络核心与 IPv6 ----------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=n
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_ip6tables-extra=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_luci-app-wol=y

# ---------- 内核模块：OpenClash 必需（关键！缺一不可） ----------
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-nf-ipt=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-nfqueue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-ipt-ipset=y

# ---------- 内核模块：内核补全 / 性能 ----------
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
CONFIG_PACKAGE_kmod-warp=y

# ---------- 内核模块：USB / 存储 / 文件系统（硬盘插件完整） ----------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-common=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-autofs4=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_kmod-crypto-crc32c=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfatprogs=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_xfs-mkfs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_libparted=y
CONFIG_PACKAGE_eject=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_ntfs3-mount=y

# ---------- 磁盘管理 ----------
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

# ---------- SMB 文件共享 ----------
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_samba4-libs=y
CONFIG_PACKAGE_samba4-client=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_ksmbd-avahi-service=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_dbus=y

# ---------- OpenClash 运行时依赖（内核之外） ----------
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_ruby-psych=y
CONFIG_PACKAGE_ruby-pstore=y
CONFIG_PACKAGE_wsdd2=y

# ★★ 关键修复：关闭 Ruby YJIT ★★
# feeds/packages/lang/ruby/Makefile 原文：
#   PKG_BUILD_DEPENDS:=ruby/host RUBY_ENABLE_YJIT:rust/host
#   config RUBY_ENABLE_YJIT
#       depends on x86_64||aarch64
#       default y if x86_64||aarch64      <-- 我们编 aarch64，默认就打开！
# 后果：为了编 Ruby 的 YJIT，构建系统会从源码编译整个 Rust 编译器 + LLVM
#       （rustc ~3795 个编译目标），实测 50 分钟都编不完，
#       把本来就要 5 小时的构建彻底拖爆 6 小时上限。
# OpenClash 用 ruby 只是为了解析 YAML，根本不需要 YJIT。
# 关掉它可以省掉整个 Rust 工具链，预计省下 1 小时以上。
CONFIG_RUBY_ENABLE_YJIT=n

# ---------- EasyTier ----------
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y

# ---------- 防校园网检测 ----------
# 不集成 UA3F：UA3F 会自己抢占 TPROXY 入口，和 OpenClash 的透明代理规则互相打架。
# 改用 rkp-ipid（纯内核模块，只改写 IP 头 IPID 字段，不参与流量转发），与 OpenClash 透明共存。
CONFIG_PACKAGE_ua3f=n

# ---------- rkp-ipid（IPID 改写，打乱 NAT 指纹） ----------
CONFIG_PACKAGE_kmod-rkp-ipid=y

# ---------- UPnP ----------
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_libminiupnpc=y

# ---------- 终端 / Web 终端 ----------
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ---------- 微信推送 ----------
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y

# ---------- 主题 ----------
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-material=y

# ---------- LuCI 基础与中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# ---------- DDNS ----------
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-utils=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ---------- 网络工具 ----------
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_arp-scan=y
CONFIG_PACKAGE_luci-app-arpbind=y

# ---------- 明确排除 Docker ----------
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_dockerd=n
CONFIG_PACKAGE_containerd=n
CONFIG_PACKAGE_runc=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=n
CONFIG_PACKAGE_luci-app-docker=n

# ---------- 其他构建选项 ----------
# 注意：这里刻意【不】开 CONFIG_DEVEL。
# DEVEL 会阻止裁剪、保留调试符号、显著增大编译量与固件体积，
# 对我们"要按时跑完 6 小时"的目标是负收益。
CONFIG_CCACHE=y
CONFIG_BUILD_LOG=n
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_MKLIBS=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_KERNEL=n
CONFIG_DEBUG=n
CONFIG_DEBUG_INFO=n
CONFIG_DEVMEM=n
CONFIG_PACKAGE_kmod-nf-flow=n
