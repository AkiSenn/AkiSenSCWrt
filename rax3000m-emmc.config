# ImmortalWrt 24.10 community MTK / Linux 6.6.133, pinned in sources.lock.json.
# RAX3000M eMMC only. Stock factory calibration; 26MHz eMMC; no Docker.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000m-emmc-mtk=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_NUMBER="24.10-MTK"
CONFIG_VERSION_MANUFACTURER="AkiSenn"
CONFIG_VERSION_PRODUCT="AkiSenSCWrt"
CONFIG_VERSION_CODE="AkiSenn"
CONFIG_INCLUDE_CONFIG=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_CCACHE=y
CONFIG_BUILD_LOG=y
# CONFIG_RUBY_ENABLE_YJIT is not set
# CONFIG_EASYTIER_INCLUDE_WEBCONSOLE is not set
# CONFIG_USE_MKLIBS is not set
# CONFIG_STRIP_KERNEL_EXPORTS is not set
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_kmod-mt7981-firmware is not set
# CONFIG_PACKAGE_mt7981-wo-firmware is not set
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_containerd is not set
# CONFIG_PACKAGE_runc is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ca-bundle=y
